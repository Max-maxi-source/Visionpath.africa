{
  "$schema": "https://openapi.vercel.sh/vercel-schema.json",
  "version": 2,
  "builds": [
    {
      "src": "**/*.php",
      "use": "@vercel/php"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "destination": "/api/$1.php"
    },
    {
      "src": "/(.*)",
      "destination": "/index.php"
    }
  ]
}
